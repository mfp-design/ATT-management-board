{
  "name": "att-management-board-production",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": { "APP_ENV": "production", "APP_INSTANCE": "att-management-board-production", "SYSTEM_EMAIL": "info@mfp-design.jp" },
  "d1_databases": [{ "binding": "DB", "database_name": "att-management-board-production-db", "database_id": "REPLACE_WITH_PRODUCTION_D1_ID" }]
}
