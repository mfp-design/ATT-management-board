{
  "name": "@att/management-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "node scripts/vite.mjs dev",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "check:config": "node scripts/check-config.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "build": "npm run check:config && npm run typecheck && node scripts/vite.mjs build",
    "preview": "node scripts/vite.mjs preview",
    "check": "npm run test && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "deploy": "node scripts/deploy-disabled.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
